# Copy to .env and fill in local values. Never commit .env.

# PostgreSQL. The postgres superuser password is not stored here.
DATABASE_URL=postgresql://negarit:change-me@127.0.0.1:5432/negarit
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=negarit
POSTGRES_USER=negarit
POSTGRES_PASSWORD=change-me

# Auth. Replace both secrets before any shared deployment.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
OTP_DELIVERY=log

# AI. mock keeps answers labeled and offline from a provider.
AI_PROVIDER=mock
LLM_API_KEY=
EMBEDDINGS_API_KEY=
TRANSLATION_API_KEY=
STT_API_KEY=
TTS_API_KEY=

# Payments stay off until a sandbox credential is verified.
PAYMENTS_CHAPA_ENABLED=false
PAYMENTS_TELEBIRR_ENABLED=false
CHAPA_SECRET_KEY=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=

# Empty map keys mean the app uses a venue floor-plan overlay.
MAPS_PROVIDER=floorplan
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
