# Copy to .env and fill in local values. Never commit .env.
# Live when filled: DATABASE_URL, CHAPA_SECRET_KEY, GOOGLE_MAPS_API_KEY.
# Demo until a credential exists: Telebirr, SMS OTP, LLM, embeddings, and speech.

# PostgreSQL. Use the Neon URL for now. A VPS database comes later.
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=negarit
POSTGRES_USER=negarit
POSTGRES_PASSWORD=change-me

# Auth. Generate both secrets locally. OTP stays in the API log until an SMS provider exists.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_DELIVERY=log

# AI. mock keeps answers labeled and offline from a provider.
AI_PROVIDER=mock
LLM_API_KEY=
EMBEDDINGS_API_KEY=
TRANSLATION_API_KEY=
STT_API_KEY=
TTS_API_KEY=

# Chapa is live when the secret is set. Telebirr stays a labeled demo.
PAYMENTS_CHAPA_ENABLED=true
PAYMENTS_TELEBIRR_ENABLED=false
CHAPA_SECRET_KEY=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=

# The visitor map stays a floor plan until the Android map SDK is wired.
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
